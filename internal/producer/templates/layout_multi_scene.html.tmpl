        else if(sc.type==="tip"){ c.appendChild(el("div","pill",sc.pill)); c.appendChild(rowsBlock(sc.rows)); }
        else if(sc.type==="casefile"){
          if(sc.hook)c.appendChild(el("h1","cf-hook",sc.hook));
          const f=el("div","cf-folder");
          f.appendChild(el("div","cf-label","CASE FILE"+(sc.caseNo?" · "+sc.caseNo:"")));
