        }
        else if(sc.type==="board"){
          const w3=el("div","cf-notes");
          (sc.rows||[]).forEach((r,ri)=>{
            const n=el("div","cf-note",r.t);
            n.style.transform="rotate("+((ri%2===0)?-2:2)+"deg)";
            n.appendChild(el("div","cf-note-pin"));
            w3.appendChild(n);
          });
          c.appendChild(w3);
        }
        else if(sc.type==="belief"){
          const card=el("div","mb-card");
          if(sc.kicker) card.appendChild(el("div","mb-kicker",sc.kicker));
          if(sc.title) card.appendChild(el("h1","mb-belief",sc.title));
          if(sc.sub) card.appendChild(el("div","mb-why",sc.sub));
          c.appendChild(card);
        }
        else if(sc.type==="proof"){
          const card=el("div","mb-card");
          if(sc.title) card.appendChild(el("h1","mb-fact",sc.title));
          if(sc.rows&&sc.rows.length) card.appendChild(rowsBlock(sc.rows));
          if(sc.source) card.appendChild(el("div","mb-src","แหล่งอ้าง: "+sc.source));
          c.appendChild(card);
        }
        else if(FORMAT_MYTH && sc.type==="verdict"){
          const card=el("div","mb-card");
          if(sc.title) card.appendChild(el("h1","mb-fact",sc.title));
          if(sc.stamp) card.appendChild(el("div","mb-stamp",sc.stamp));
          if(sc.meter){
            const half=(sc.meter==="half_true");
            const on=(sc.meter==="false")?3:(half?2:1);
            const m=el("div","mb-meter"+(half?" half":""));
            for(let k=1;k<=3;k++){m.appendChild(el("div","lv"+(k<=on?" on":"")));}
            card.appendChild(m);
            const lbl=el("div","mb-meter-l");
            ["เคยจริง","ครึ่งเดียว","ไม่จริง"].forEach(function(t){lbl.appendChild(el("span",null,t));});
            card.appendChild(lbl);
          }
          c.appendChild(card);
        }
        else if(sc.type==="verdict"){
          if(sc.caseNo)c.appendChild(el("div","kicker","สรุปสำนวน · "+sc.caseNo));
          c.appendChild(el("h1","title",sc.title));
          if(sc.stamp)c.appendChild(el("div","cf-stamp-green",sc.stamp));
          if(sc.cta)c.appendChild(el("div","cta",sc.cta));
          if(sc.brand)c.appendChild(el("div","brandbig",sc.brand));
          if(sc.sub)c.appendChild(el("div","sub",sc.sub));
        }
        else if(sc.type==="uistep"){
          const rail=el("div","ui-rail");
          if(sc.of) rail.appendChild(el("div","rl",sc.of));
          const total=sc.stepTotal||0, cur=parseInt(sc.num,10)||0;
          if(total>0){
            const dots=el("div","dots");
            for(let k=1;k<=total;k++) dots.appendChild(el("i","dot"+(k<=cur?" on":"")));
            rail.appendChild(dots);
          }
          c.appendChild(rail);
          if(sc.title) c.appendChild(el("div","ui-step-title",sc.title));
          const p=sc.panel||{};
          const box=el("div","ui-panel");
          const ch=el("div","ui-chrome");
          const ds=el("div","dotset");
          for(let k=0;k<3;k++) ds.appendChild(el("i"));
          ch.appendChild(ds);
          if(p.chrome) ch.appendChild(el("div","title",p.chrome));
          box.appendChild(ch);
          if(p.breadcrumb) box.appendChild(el("div","ui-crumb",p.breadcrumb));
          const list=el("div","ui-list");
          let targetRow=null;
          (p.items||[]).forEach(it=>{
            const row=el("div","ui-item "+(it.state||"normal"));
            row.appendChild(el("span","lb",it.label));
            row.appendChild(el("span","mk"));
            list.appendChild(row);
            if((it.state||"")==="target" && !targetRow) targetRow=row;
          });
          box.appendChild(list);
          if(p.field){
            const f=el("div","ui-field");
            f.appendChild(el("div","fl",p.field.label));
            f.appendChild(el("div","fv",p.field.value));
            box.appendChild(f);
          }
          c.appendChild(box);
          if(sc.callout) c.appendChild(el("div","ui-note",sc.callout));
          // The pointer tag + tap ring are pinned to the target row's centre,
          // measured after layout (offsets are relative to .ui-panel, which is
          // position:relative). A panel with no target row gets neither.
          if(targetRow) uiStepMarkers.push({box:box,row:targetRow});
        }
        else if(sc.type==="chat_in" || sc.type==="chat_out"){
          if(sc.asker){
            const head=el("div","ch-head");
            head.appendChild(el("div","ch-ava",(sc.asker||"?").trim().charAt(0)));
            const nw=el("div");
            nw.appendChild(el("div","ch-name",sc.asker));
            if(sc.stamp) nw.appendChild(el("div","ch-stamp",sc.stamp));
            head.appendChild(nw);
            c.appendChild(head);
          }
          const th=el("div","ch-thread");
          (sc.msgs||[]).forEach(m=>{
            const side=(m.from==="me")?"me":"them";
            th.appendChild(el("div","ch-bub "+side+(m.alert?" alert":""),m.t));
          });
          c.appendChild(th);
          if(sc.verdict) c.appendChild(el("div","ch-verdict",sc.verdict));
        }
        else if(sc.type==="recap"){
          if(sc.title) c.appendChild(el("h1","title",sc.title));
          if(sc.chips) c.appendChild(chipsBlock(sc.chips));
        }
        else if(sc.type==="dashboard"){
          const live=el("div","wr-live");live.appendChild(el("i"));
          live.appendChild(el("span",null,"LIVE"));c.appendChild(live);
          const g=el("div","wr-gauge");
          if(sc.statLabel) g.appendChild(el("div","wr-gauge-l",sc.statLabel));
          g.appendChild(sparkChart((sc.statLabel||"")+"|"+(sc.callout||"")+"|"+i));
          c.appendChild(g);
          if(sc.chips&&sc.chips.length){
            const k=el("div","wr-kpis");
            sc.chips.forEach(ch=>{
              const t=el("div","wr-kpi"+(ch.bad?" bad":""));
              t.appendChild(el("div","n",ch.n));
              t.appendChild(el("div","t",ch.t));
              k.appendChild(t);
            });
            c.appendChild(k);
          }
          if(sc.callout) c.appendChild(el("div","wr-alarm",sc.callout));
        }
        else if(sc.type==="alarm"){
          if(sc.title) c.appendChild(el("h1","title",sc.title));
          c.appendChild(rowsBlock(sc.rows));
        }
        else if(sc.type==="cta"){
          c.appendChild(el("h1","title",sc.title));
          c.appendChild(el("div","cta",sc.cta));
          c.appendChild(el("div","brandbig",sc.brand));
          if(sc.sub)c.appendChild(el("div","sub",sc.sub));
        }
      });

      // ── uistep markers: pin the "กดตรงนี้" tag above the target row and the tap
      // ring on it. Runs once after the builder so offsetTop/offsetHeight reflect
      // the final wrapped layout.
      function placeUIStepMarkers(){
        uiStepMarkers.forEach(function(m){
          const top=m.row.offsetTop, mid=top+m.row.offsetHeight/2;
          const tag=el("div","ui-point","กดตรงนี้");
          tag.style.top=(top-14)+"px";
          m.box.appendChild(tag);
          const tap=el("div","ui-tap");
          tap.appendChild(el("div","rg"));
          tap.appendChild(el("div","dt"));
          tap.style.top=mid+"px";
          tap.style.left=(m.row.offsetLeft+m.row.offsetWidth-104)+"px";
          m.box.appendChild(tap);
        });
      }
      if(document.fonts&&document.fonts.ready){document.fonts.ready.then(placeUIStepMarkers);}else{placeUIStepMarkers();}

      // ── auto-fit: Kanit/Prompt Thai glyphs run wider than the Sarabun these px
      // sizes were tuned for. Both .stat and .chip .n are nowrap blocks that can
      // overflow their box; shrink font-size until they fit (floor 55%). Layout
      // is computed even while scenes sit at opacity:0, so measuring here is
      // safe. The MOTION_V2 stat counts up from "0", so measure at its widest
      // (final) value first. Runs after document.fonts.ready (when available) so
      // scrollWidth reflects real Kanit/Prompt metrics, not the fallback font.
      function fitText(node){
        let size=parseFloat(getComputedStyle(node).fontSize);
        const min=size*0.55;
        let guard=60;
        // never write "guard-->0" here: html/template treats "-->" inside <script>
        // as an HTML comment close and truncates the rest of the line, killing the
        // whole inline script (blank video, audio only).
        while(guard>0&&size>min&&node.scrollWidth>node.clientWidth+1){
          guard--;
          size=Math.max(min,size-2);
          node.style.fontSize=size+"px";
        }
      }
      function autoFit(){
        document.querySelectorAll(".scene-content .stat,.scene-content .chip .n").forEach(function(node){
          node.style.fontSize=""; // re-entry safe: always measure from the CSS size
          const num=node.querySelector(".stat-num");
          if(num)num.textContent=num.getAttribute("data-final")||"0";
          fitText(node);
          {{- if .Cover}}
          // Cover scene 0's stat is pinned to its final value (see the
          // per-scene entrance loop below) — don't re-zero it here, or the
          // poster frame flashes "0" before the timeline sets the real number.
          if(COVER && num && SCENES[0] && SCENES[0].type==="stat" && node.closest("#scene-"+SCENES[0].scene)){ return; }
          {{- end}}
          if(num)num.textContent="0";
        });
      }
      if(document.fonts&&document.fonts.ready){document.fonts.ready.then(autoFit);}else{autoFit();}

      // ── continuous overlays ──
      tl.fromTo("#progressFill",{width:0},{width:{{.Width}},duration:TOTAL,ease:"none"},0);
{{- if .Cover}}
      // Cover: the ADS VANCE badge must brand the poster frame — pin it visible
      // at t=0 (the slide-in fromTo below would immediateRender it to opacity:0
      // on frame 0, leaving the poster unbranded).
      tl.set("#badges",{opacity:1,x:0},0);
{{- else}}
      tl.fromTo("#badges",{opacity:0,x:-40},{opacity:1,x:0,duration:.6,ease:"power3.out"},0.3);
{{- end}}
      tl.to("#badges",{opacity:0,y:-20,duration:.5,ease:"power2.in"},Math.min(7,TOTAL*0.18));

      // A1 entrance pacing factors (multiply base entrance durations):
      // fast = snappy hook, slow = premium hero/stat reveal, absent = normal (1.0).
      const SPEED_FACTORS={fast:0.7,slow:1.35};
      // cut-the-curve seam: partial travel ~12% of frame width, leftward
      // current. One duration on both sides of the cut — with the mirrored
      // power4 pair this makes the velocity match exact by construction.
      const SEAM_DX=Math.round({{.Width}}*0.12), SEAM_DUR=0.36;
      // contentEntrance returns the from/to vars for a scene's content entrance.
      // MOTION_V2 off → the legacy rise (y-based). MOTION_V2 on → per-scene
      // geometry from sc.entrance (punch/rise/slide); slide always enters from
      // the right — one directional current per clip, never ping-pong.
      function contentEntrance(sc, motionUp){
        const base = motionUp ? 60 : 46;
        const rise = {from:{y:base,opacity:0}, to:{y:0,opacity:1}};
        if(!MOTION_V2) return rise;
        const v = sc.entrance || "rise";
        if(v==="slide"){ return {from:{x:80,opacity:0}, to:{x:0,opacity:1}}; }
        if(v==="punch"){ return {from:{scale:0.9,opacity:0}, to:{scale:1,opacity:1}}; }
        return rise;
      }
      // parseStatNumber extracts the leading number of a stat string ("80",
      // "1,200", "3.5") → {value, decimals, grouped}, or null if non-numeric.
      function parseStatNumber(s){
        const m = String(s||"").match(/^\s*([\d.,]+)\s*$/);
        if(!m) return null;
        const raw = m[1];
        const grouped = raw.indexOf(",") >= 0;
        const clean = raw.replace(/,/g,"");
        const value = parseFloat(clean);
        if(!isFinite(value)) return null;
        const dot = clean.indexOf(".");
        const decimals = dot >= 0 ? clean.length - dot - 1 : 0;
        return {value:value, decimals:decimals, grouped:grouped};
      }
      function formatStat(v, meta){
        let s = meta.decimals > 0 ? v.toFixed(meta.decimals) : String(Math.round(v));
        if(meta.grouped){ const parts = s.split("."); parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ","); s = parts.join("."); }
        return s;
      }
      // KPI ของห้องควบคุมนับขึ้นเหมือนซีน stat แต่เลขมักมีเครื่องหมายติดมาด้วย
      // ("+38%", "1.4x") ซึ่ง parseStatNumber รับเฉพาะตัวเลขล้วน จึงต้องแยกหัว/ท้าย
      // ออกก่อนแล้วนับเฉพาะแกนตัวเลข · ค่าที่เป็น 0 ข้ามไป นับ 0→0 ไม่มีอะไรให้ดู
      function kpiCountUp(sceneEl,at,span){
        sceneEl.querySelectorAll(".wr-kpi .n").forEach(function(nEl){
          const m=String(nEl.textContent||"").match(/^(\D*)([\d.,]+)(\D*)$/);
          if(!m)return;
          const meta=parseStatNumber(m[2]);
          if(!meta||meta.value<=0)return;
          const pre=m[1],post=m[3],proxy={v:0};
          nEl.textContent=pre+formatStat(0,meta)+post;
          tl.to(proxy,{v:meta.value,duration:Math.min(1.1,Math.max(0.5,span*0.5)),ease:"power1.out",
            onUpdate:function(){nEl.textContent=pre+formatStat(proxy.v,meta)+post;}},at);
        });
      }
      // springEase — damped-spring position curve baked into a seek-safe GSAP
      // ease (underdamped closed form, z<1 — the only register this template
      // uses). Deterministic: fixed-step scan, no Math.random / Date.now.
      // response ≈ seconds per oscillation; z 0.85 ≈ the iOS register (~1%
      // overshoot, felt not seen). Overshooting eases go on transforms only —
      // never opacity (it would push past 1).
      function springEase(response, z){
        const w=(2*Math.PI)/response;
        const wd=w*Math.sqrt(1-z*z);
        const pos=function(t){return 1-Math.exp(-z*w*t)*(Math.cos(wd*t)+((z*w)/wd)*Math.sin(wd*t));};
        const SCAN=12/(z*w), N=4800;
        let T=SCAN;
        for(let i=N;i>=0;i--){
          const t=(i/N)*SCAN;
          if(Math.abs(1-pos(t))>0.001){T=((i+1)/N)*SCAN;break;}
        }
        const xT=pos(T);
        return {duration:T,ease:function(p){return pos(p*T)+p*(1-xT);}};
      }
      const STAT_SETTLE=springEase(0.35,0.85);
      // ── per-scene: ONE entrance per element, no conflicting tweens ──
      SCENES.forEach((sc,idx)=>{
        const sceneEl=document.getElementById("scene-"+sc.scene);
        if(!sceneEl)return;
        const isFirst=idx===0, isLast=idx===SCENES.length-1;
        const inAt=sc.start;   // no pre-roll — the first tween lines up with data-start exactly
        const content=sceneEl.querySelector(".scene-content");
        const bg=sceneEl.querySelector(".scene-bg");
        const span=Math.max(0.4,sc.end-inAt);

        const SPEED_FACTOR=SPEED_FACTORS[sc.speed]||1.0;

        {{if .Cover -}}
        if(COVER && idx===0){
          // Frame-0 cover: the platform grabs frame 0 as the poster, so scene 0
          // and its content must be fully visible at t=0 — NEVER opacity:0. Only a
          // subtle scale settle from a visible state (no fade-in). Content is also
          // pinned visible so the hook reads immediately.
          const durIn = ENTRANCE_DUR * (SPEED_FACTOR || 1);
          tl.set(sceneEl,{opacity:1},0);
          tl.fromTo(sceneEl,{scale:1.03},{scale:1,duration:Math.max(0.5,durIn),ease:ENTRANCE_EASE},0);
          if(content){ tl.set(content,{opacity:1,x:0,y:0,scale:1},0); }
          // Poster frame must stay alive, not dead-still: ken-burns the bg from
          // t=0 (like the MOTION_UP/legacy branches do over their own span).
          if(bg) tl.fromTo(bg,{scale:1.04},{scale:BG_ZOOM_TO,duration:span,ease:"none"},0);
        } else if (MOTION_UP) {
        {{- else -}}
        if (MOTION_UP) {
        {{- end}}
          // Scene 0 fades up from black; later scenes take a cut-the-curve
          // hand-off: the slab picks up mid-fade (opacity .35) already moving
          // leftward, decelerating into place — velocity-matched to the
          // previous scene's power4.in exit.
          if(isFirst){
            tl.fromTo(sceneEl,{opacity:0,scale:1.04},{opacity:1,scale:1,duration:0.5,ease:ENTRANCE_EASE},inAt);
          }else{
            tl.fromTo(sceneEl,{x:SEAM_DX,opacity:0.35},{x:0,opacity:1,duration:SEAM_DUR,ease:"power4.out"},inAt);
          }
          if(bg) tl.fromTo(bg,{scale:1.04},{scale:BG_ZOOM_TO,duration:span,ease:"none"},inAt);
          if(content){
            // seam timing is speed-invariant by design (velocity match at the
            // cut); only the content entrance scales with the scene's speed.
            const durIn=ENTRANCE_DUR*SPEED_FACTOR;
            const ce=contentEntrance(sc,true);
            tl.fromTo(content,ce.from,Object.assign({},ce.to,{duration:durIn,ease:ENTRANCE_EASE}),sc.start+0.08);
          }
        } else {
          // Current behavior, now speed-scaled per scene.
          const contentDurIn=0.6*SPEED_FACTOR;
          tl.fromTo(sceneEl,{opacity:0},{opacity:1,duration:isFirst?0.5:0.55*SPEED_FACTOR,ease:"power2.out"},inAt);
          if(bg) tl.fromTo(bg,{scale:1.0},{scale:1.06,duration:span,ease:"none"},inAt);
          if(content){
            const ce=contentEntrance(sc,false);
            tl.fromTo(content,ce.from,Object.assign({},ce.to,{duration:contentDurIn,ease:"power3.out"}),sc.start+0.1);
          }
        }

        if(content{{if .Cover}} && !(COVER && idx===0){{end}}){
          const kids=content.children;
          for(let j=0;j<kids.length;j++){
            const isStat=kids[j].querySelector&&kids[j].querySelector(".stat");
            const at=sc.start+(isStat?0.28+j*0.08:0.26+j*0.09);
            if(isStat){
              tl.fromTo(kids[j],{scale:0.78},{scale:1,duration:STAT_SETTLE.duration,ease:STAT_SETTLE.ease},at);
              tl.fromTo(kids[j],{opacity:0},{opacity:1,duration:0.3,ease:"power2.out"},at);
            }else{
              tl.fromTo(kids[j],{opacity:0,y:18},{opacity:1,y:0,duration:0.42,ease:"power3.out"},at);
            }
          }
        }

        {{- if .Cover}}
        if(COVER && idx===0 && sc.type==="stat"){
          // Poster frame shows the real number, not a recount: pin the final
          // formatted value directly and skip the 0->final count-up entirely.
          const numEl0 = sceneEl.querySelector(".stat-num");
          const meta0 = parseStatNumber(sc.stat);
          if(numEl0 && meta0){ numEl0.textContent = formatStat(meta0.value, meta0); }
        } else
        {{- end}}
        // เฟรมโปสเตอร์ต้องโชว์เลขจริง ไม่ใช่ 0 ที่ยังไม่ทันนับ · เงื่อนไข COVER เชื่อมด้วย
        // template action เหมือนที่อื่นในไฟล์ เพราะคลิปที่ไม่มีปกต้องไม่มีคำว่า COVER โผล่
        // ใน output เลย (invariant ที่ TestRenderCompositionScenes_Cover ล็อกไว้)
        // ห้ามพิมพ์ template action ลงในคอมเมนต์ JS — Go template อ่านมันเป็นบล็อกจริง
        if(MOTION_V2 && sc.type==="dashboard"{{if .Cover}} && !(COVER && idx===0){{end}}){
          kpiCountUp(sceneEl, sc.start+0.3, span);
        }
        if(MOTION_V2 && sc.type==="stat"){
          const numEl = sceneEl.querySelector(".stat-num");
          const meta = parseStatNumber(sc.stat);
          if(numEl && meta){
            const proxy = {v:0};
            tl.to(proxy,{v:meta.value,duration:Math.min(1.1,Math.max(0.5,span*0.5)),ease:"power1.out",
              onUpdate:function(){ numEl.textContent = formatStat(proxy.v, meta); }},sc.start+0.3);
          }
        }
        // cut-the-curve exit: the slab accelerates leftward and the fade dies
        // exactly at the cut, so something is always moving across the seam.
        // MOTION_UP-only so the seam pair stays whole — the matching entry
        // lives in the MOTION_UP branch above; legacy keeps its fade world.
        if(MOTION_UP && !isLast){
          tl.to(sceneEl,{x:-SEAM_DX,duration:SEAM_DUR,ease:"power4.in"},sc.end-SEAM_DUR);
          tl.to(sceneEl,{opacity:0,duration:0.3,ease:"power2.in"},sc.end-0.3);
        }
        // last-scene guard (and x reset for seam scenes) — the exit tweens
        // already land at these values for every other scene.
        tl.set(sceneEl,{opacity:0,x:0},sc.end);
      });

      // ── captions (phrase fade + key-word amber) ──
      const seg2=typeof Intl!=="undefined"&&Intl.Segmenter?new Intl.Segmenter(undefined,{granularity:"grapheme"}):null;
      function gl(t){if(seg2){let o=[];for(const s of seg2.segment(t))o.push(s.segment);return o;}return Array.from(t);}
      function splitWords(t){const o=[];const re=/\S+\s*/g;let m;while((m=re.exec(t))!==null)o.push(m[0]);if(!o.length&&t.length)o.push(t);return o;}
      function keyIdx(ws,emph){
        // Prefer a word that matches the scene's emphasis; fall back to longest.
        if(emph&&emph.length){
          for(let i=0;i<ws.length;i++){const t=ws[i].trim();
            for(const e of emph){if(e&&t.indexOf(e)>=0)return i;}}
        }
        let b=0,bl=-1;ws.forEach((w,i)=>{const l=gl(w.trim()).length;if(l>bl){bl=l;b=i;}});return b;
      }
      // A4 key-word glow color, read from the active palette so it tracks the brand
      // instead of a hardcoded hex (falls back to brand orange if the var is missing).
      const accentHex=getComputedStyle(document.documentElement).getPropertyValue("--amber-bright").trim();
      const KEY_ACCENT=/^#[0-9a-fA-F]{6}$/.test(accentHex)?accentHex:"#F0A030";
      const capStage=document.getElementById("capStage");
      SEGMENTS.forEach((seg,i)=>{
        const p=el("div","cap-phrase");
        const ws=splitWords(seg.text);const k=keyIdx(ws,seg.emph);
        let keyEl=null;
        ws.forEach((w,wi)=>{const s=el("span","cap-word"+(wi===k?" key":""));s.textContent=w;p.appendChild(s);if(wi===k)keyEl=s;});
        capStage.appendChild(p);
        const inAt=seg.start;
        const outAt=i<SEGMENTS.length-1?SEGMENTS[i+1].start:seg.end;
        tl.fromTo(p,{opacity:0,y:16},{opacity:1,y:0,duration:0.28,ease:"power3.out"},inAt);
        // A4: the emphasis word pops in with a scale + palette glow, then settles to a
        // soft resting glow so it stays legible. GSAP-only (seek-safe) — no CSS keyframes.
        // 8-digit hex alpha (E6≈.9, 66≈.4, 00=0) keeps the color palette-driven.
        if(keyEl){
          tl.fromTo(keyEl,{scale:1,textShadow:"0 0 0px "+KEY_ACCENT+"00"},
            {scale:1.14,textShadow:"0 0 20px "+KEY_ACCENT+"E6",duration:0.24,ease:"back.out(1.7)"},inAt+0.10);
          tl.to(keyEl,{scale:1,textShadow:"0 0 8px "+KEY_ACCENT+"66",duration:0.30,ease:"power2.out"},inAt+0.38);
        }
        tl.to(p,{opacity:0,y:-12,duration:0.22,ease:"power2.in"},Math.max(inAt+0.4,outAt-0.2));
        tl.set(p,{opacity:0},outAt);
      });

      tl.set({},{},TOTAL);
      window.__timelines=window.__timelines||{};
      window.__timelines["main"]=tl;
    </script>
  </body>
