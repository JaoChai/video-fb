{{define "layout_multi_scene.html.tmpl"}}<!doctype html>
<html lang="th" data-resolution="{{if eq .Width 1080}}portrait{{else}}landscape{{end}}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{.Width}}, height={{.Height}}" />
    <script src="assets/gsap.min.js"></script>
    <style>
      @font-face{font-family:"Sarabun";src:url("assets/fonts/Sarabun-Regular.ttf") format("truetype");font-weight:400;font-display:block}
      @font-face{font-family:"Sarabun";src:url("assets/fonts/Sarabun-SemiBold.ttf") format("truetype");font-weight:600;font-display:block}
      @font-face{font-family:"Sarabun";src:url("assets/fonts/Sarabun-Bold.ttf") format("truetype");font-weight:700;font-display:block}
      @font-face{font-family:"Sarabun";src:url("assets/fonts/Sarabun-ExtraBold.ttf") format("truetype");font-weight:800;font-display:block}
      @font-face{font-family:"Kanit";src:url("assets/fonts/Kanit-Bold.ttf") format("truetype");font-weight:700;font-display:block}
      @font-face{font-family:"Kanit";src:url("assets/fonts/Kanit-ExtraBold.ttf") format("truetype");font-weight:800;font-display:block}
      @font-face{font-family:"Kanit";src:url("assets/fonts/Kanit-Black.ttf") format("truetype");font-weight:900;font-display:block}
      @font-face{font-family:"Prompt";src:url("assets/fonts/Prompt-SemiBold.ttf") format("truetype");font-weight:600;font-display:block}
      @font-face{font-family:"Prompt";src:url("assets/fonts/Prompt-Bold.ttf") format("truetype");font-weight:700;font-display:block}
      @font-face{font-family:"Prompt";src:url("assets/fonts/Prompt-ExtraBold.ttf") format("truetype");font-weight:800;font-display:block}
      @font-face{font-family:"IBM Plex Sans Thai";src:url("assets/fonts/IBMPlexSansThai-Medium.ttf") format("truetype");font-weight:500;font-display:block}
      @font-face{font-family:"IBM Plex Sans Thai";src:url("assets/fonts/IBMPlexSansThai-SemiBold.ttf") format("truetype");font-weight:600;font-display:block}

      {{.BrandCSS}}
      /* Style-B body uses --amber* but BrandCSS emits --orange*; alias so the
         brand stays single-source. (--red/--green/--ease-* already in BrandCSS.) */
      :root{ --amber:var(--orange); --amber-soft:var(--orange-soft); --amber-bright:var(--orange-bright); }
      .kicker,h1.title,.stat,.stat-label,.step-of,.step-title,.pill,.cta,.brandbig,
      .chip .n,.badge-brand,.cap-word.key{font-family:var(--font-heading,"Sarabun"),sans-serif}
      *{margin:0;padding:0;box-sizing:border-box}
      html,body{width:{{.Width}}px;height:{{.Height}}px;overflow:hidden;background:var(--navy-deep)}
      /* Thai-safe: NEVER negative letter-spacing (it collides vowels/tone marks) */
      #root{position:relative;width:{{.Width}}px;height:{{.Height}}px;overflow:hidden;
        font-family:"Sarabun",sans-serif;letter-spacing:0;color:var(--ink);background:var(--navy-deep)}

      /* ── scene shell ── */
      .scene{position:absolute;inset:0;opacity:0;overflow:hidden}
      /* the ken-burns tween scales .scene-bg past the frame; without its own
         clipping layer that overflow lands in .scene's scrollHeight, and
         `hyperframes inspect` reports it as clipped_text on the scene itself */
      .scene-bg-wrap{position:absolute;inset:0;overflow:hidden}
      .scene-bg{position:absolute;inset:0;background-position:center top;background-size:cover;
        background-repeat:no-repeat;will-change:transform;transform-origin:center center}
      /* strong scrim: image reads at top, content sits on clean navy below */
      .scrim{position:absolute;inset:0;background:
        linear-gradient(180deg, rgba(6,24,64,.12) 0%, rgba(6,24,64,.55) 40%, rgba(6,24,64,.92) 60%, var(--navy-deep) 100%)}

      /* content lives in the lower ~55%, above the caption band */
      .scene-content{position:absolute;left:56px;right:56px;bottom:430px;
        display:flex;flex-direction:column;gap:26px;align-items:stretch}

      /* A2: per-layout composition so scenes don't all sit dead-center. Each rule
         only nudges position/width/alignment — content elements are unchanged, so
         `hyperframes inspect` still guards against overflow. hero keeps the default. */
      .scene[data-layout="hook"] .scene-content{bottom:560px}                 /* raise the opener high on frame */
      .scene[data-layout="step"] .scene-content,
      .scene[data-layout="tip"]  .scene-content{align-items:flex-start}       /* left-align step & tip flow */
      .scene[data-layout="tip"]  .pill{align-self:flex-start}                 /* pill follows the left edge */
      /* dead-center the close. The 60px inset is a bumper, not a layout change:
         it is symmetric so the centered block sits exactly where top/bottom:0 put
         it, but the entrance tween (translateY 46px) can no longer push text past
         the frame — which `hyperframes inspect` reads as clipped_text. */
      .scene[data-layout="cta"]  .scene-content{top:60px;bottom:60px;justify-content:center}

      .kicker{font-weight:800;font-size:30px;line-height:1.3;letter-spacing:.10em;color:var(--amber-bright);text-align:center}

      /* Thai needs a loose line-height: at 1.06 the upper vowels/tone marks of a
         wrapped second line collide with the line above (ทับซ้อน). 1.32 + a little
         top room clears the stacked marks. */
      h1.title{font-weight:800;font-size:96px;line-height:1.32;padding-top:.06em;color:#fff;text-align:center;
        text-shadow:0 3px 16px rgba(0,0,0,.6)}
      h1.title .slab{color:#fff;background:var(--amber);padding:.02em .14em;border-radius:12px;
        box-decoration-break:clone;-webkit-box-decoration-break:clone}
      h1.title .acc{color:var(--amber-bright)}

      /* glass card */
      .card{background:linear-gradient(180deg,rgba(20,60,140,.5),rgba(10,35,88,.55));
        border:1.5px solid rgba(188,210,255,.26);border-radius:34px;padding:46px 44px;
        box-shadow:0 26px 70px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.16);backdrop-filter:blur(2px)}

      /* stat */
      .stat{font-weight:800;font-size:230px;line-height:.9;color:var(--amber-bright);text-align:center;
        white-space:nowrap;font-variant-numeric:tabular-nums;text-shadow:0 8px 44px rgba(255,180,84,.3)}
      .stat .unit{font-size:.37em;color:#fff;margin-left:10px}
      .stat-label{margin-top:14px;font-weight:700;font-size:42px;color:#fff;text-align:center;line-height:1.25}

      /* chips row */
      .chips{display:flex;gap:20px}
      .chip{flex:1;background:rgba(10,35,88,.66);border:1.5px solid rgba(188,210,255,.2);
        border-radius:22px;padding:26px 20px;text-align:center}
      .chip .n{font-weight:800;font-size:52px;white-space:nowrap;color:#fff}
      .chip .t{margin-top:6px;font-weight:600;font-size:26px;color:var(--muted);line-height:1.3}

      /* step header */
      .step-head{display:flex;align-items:center;gap:24px}
      .step-num{flex:0 0 auto;width:118px;height:118px;border-radius:28px;
        background:linear-gradient(135deg,var(--amber),var(--amber-soft));
        display:flex;align-items:center;justify-content:center;
        font-weight:800;font-size:72px;color:#fff;box-shadow:0 16px 40px rgba(255,180,84,.4)}
      .step-of{font-weight:700;font-size:30px;line-height:1.3;letter-spacing:.08em;color:var(--amber-bright)}
      .step-title{font-weight:800;font-size:60px;line-height:1.3;color:#fff}

      /* bullet rows (no emoji — amber dot) */
      .rows{display:flex;flex-direction:column;gap:16px}
      .row{display:flex;align-items:flex-start;gap:18px;
        background:rgba(10,35,88,.6);border:1px solid rgba(255,255,255,.08);
        border-radius:20px;padding:24px 28px}
      .row .dot{flex:0 0 auto;width:18px;height:18px;margin-top:14px;border-radius:50%;
        background:var(--amber-bright);box-shadow:0 0 14px rgba(255,180,84,.6)}
      .row .rt{font-weight:700;font-size:40px;line-height:1.26;color:#fff}
      .row.bad .dot{background:var(--red);box-shadow:0 0 14px rgba(255,107,98,.6)}
      .row.bad .rt{color:#ffd9d6}

      /* badge pill (TIP / category) */
      .pill{align-self:center;font-weight:800;font-size:30px;letter-spacing:.12em;
        color:var(--amber-bright);border:2px solid var(--amber-bright);background:rgba(255,180,84,.08);
        padding:14px 30px;border-radius:999px}

      .sub{font-weight:600;font-size:42px;line-height:1.3;color:var(--muted);text-align:center}

      /* cta */
      .cta{align-self:center;font-weight:800;font-size:46px;color:#fff;
        background:linear-gradient(135deg,var(--amber),var(--amber-soft));
        padding:26px 64px;border-radius:999px;box-shadow:0 20px 56px rgba(255,180,84,.4)}
      .brandbig{font-weight:800;font-size:88px;line-height:1.3;color:#fff;text-align:center;letter-spacing:.04em}

      /* ── case-file format (data-format='case') ──
         Thai-safe ตามกติกาไฟล์นี้: letter-spacing >= 0, line-height >= 1.3,
         overflow-wrap:break-word เท่านั้น. Animation = GSAP timeline เดิม (ผ่าน
         kids-stagger ที่มีอยู่) — ไม่มี CSS transition/keyframes ใหม่ */
      .cf-folder{background:#E9DCB5;color:#3A2E12;border-radius:20px 34px 20px 20px;
        padding:52px 48px 44px;position:relative;box-shadow:0 30px 80px rgba(0,0,0,.5);
        display:flex;flex-direction:column;align-items:flex-start}
      .cf-folder::before{content:"";position:absolute;top:-26px;left:44px;width:300px;height:40px;
        background:#E9DCB5;border-radius:18px 18px 0 0}
      .cf-label{font-weight:800;font-size:30px;letter-spacing:.16em;color:#8A6D2F}
      .cf-name{font-weight:800;font-size:64px;line-height:1.32;padding-top:.06em;margin-top:8px;
        overflow-wrap:break-word;max-width:100%}
      .cf-meta{margin-top:18px;display:flex;flex-direction:column;gap:8px;max-width:100%}
      .cf-meta-line{font-weight:600;font-size:34px;line-height:1.4;color:#6B5622;overflow-wrap:break-word}
      .cf-stamp-red{display:inline-block;transform:rotate(-8deg);border:5px solid #C0392B;color:#C0392B;
        font-weight:800;font-size:40px;line-height:1.3;letter-spacing:.14em;padding:10px 30px;
        border-radius:14px;background:rgba(255,255,255,.55);margin-top:26px}
      .cf-panels{display:flex;flex-direction:column;gap:26px}
      .cf-panel{position:relative;background:#FFF6E6;color:#2A2113;border:6px solid #101C36;
        border-radius:14px;padding:32px 32px 28px;box-shadow:10px 10px 0 rgba(0,0,0,.55)}
      .cf-panel.dark{background:#16264A;color:#fff}
      .cf-panel-halftone{position:absolute;inset:0;border-radius:8px;opacity:.10;pointer-events:none;
        background-image:radial-gradient(#000 2px,transparent 2.4px);background-size:18px 18px}
      .cf-panel.dark .cf-panel-halftone{background-image:radial-gradient(#fff 2px,transparent 2.4px)}
      .cf-panel-time{position:absolute;top:-24px;left:26px;background:var(--amber);color:#fff;
        font-weight:800;font-size:26px;line-height:1.3;letter-spacing:.1em;padding:6px 20px;
        border-radius:10px;border:4px solid #101C36}
      .cf-panel-title{font-weight:800;font-size:44px;line-height:1.32;padding-top:.06em;overflow-wrap:break-word}
      .cf-panel-quote{font-weight:600;font-size:32px;line-height:1.4;margin-top:8px;color:#6B5622;overflow-wrap:break-word}
      .cf-panel.dark .cf-panel-quote{color:#BCD2FF}
      .cf-polaroid{align-self:center;background:#fff;padding:26px 26px 30px;border-radius:10px;
        box-shadow:0 30px 70px rgba(0,0,0,.55);transform:rotate(-3deg);position:relative;width:720px;max-width:100%}
      .cf-photo{display:block;width:100%;height:560px;object-fit:cover;border-radius:6px;background:#DDE4F0}
      .cf-photo-blank{background:linear-gradient(160deg,#E7ECF6,#C9D4E8)}
      .cf-stamp-onphoto{position:absolute;top:32%;left:10%;margin-top:0}
      .cf-polaroid-label{margin-top:18px;text-align:center;font-weight:700;font-size:30px;
        line-height:1.35;color:#43506B;overflow-wrap:break-word}
      .cf-notes{display:flex;flex-direction:column;gap:30px}
      .cf-note{position:relative;background:#FFF3C4;color:#4A3A08;border-radius:10px;
        padding:30px 36px;font-weight:700;font-size:40px;line-height:1.35;
        box-shadow:0 22px 50px rgba(0,0,0,.45);overflow-wrap:break-word}
      .cf-note-pin{position:absolute;top:-14px;left:50%;margin-left:-15px;width:30px;height:30px;
        border-radius:50%;background:var(--red);box-shadow:0 6px 12px rgba(0,0,0,.4)}
      .cf-stamp-green{align-self:center;transform:rotate(-7deg);border:6px solid var(--green);
        color:var(--green);font-weight:800;font-size:54px;line-height:1.3;letter-spacing:.14em;
        padding:14px 40px;border-radius:16px}
      .cf-folder .cf-label,.cf-name,.cf-panel-title,.cf-note,.cf-stamp-red,
      .cf-stamp-green{font-family:var(--font-heading,"Sarabun"),sans-serif}
      [data-format='case'] .scrim{background:
        linear-gradient(180deg, rgba(6,24,64,.35) 0%, rgba(6,24,64,.75) 45%, rgba(6,24,64,.96) 62%, var(--navy-deep) 100%)}
      /* full-frame pass (visual full-frame spec 2026-07-24) */
      .cf-hook{font-weight:800;font-size:84px;line-height:1.32;padding-top:.06em;color:#fff;
        text-align:left;text-shadow:0 4px 20px rgba(0,0,0,.7);overflow-wrap:break-word;
        font-family:var(--font-heading,"Sarabun"),sans-serif}
      .cf-hook .acc{color:var(--amber-bright)}
      .cf-wm{position:absolute;top:150px;right:36px;font-weight:900;font-size:190px;line-height:1.3;
        letter-spacing:0;color:rgba(188,210,255,.07);font-family:var(--font-heading,"Sarabun"),sans-serif;
        white-space:nowrap;pointer-events:none}
      [data-format='case'] .scene-bg::after{content:"";position:absolute;inset:0;
        background-image:radial-gradient(rgba(188,210,255,.05) 2px,transparent 2.4px);
        background-size:26px 26px}
      /* casefile poster: hook on top over the cover image, folder pinned low */
      [data-format='case'] .scene[data-layout="casefile"] .scene-content{top:200px;bottom:430px;
        justify-content:space-between;align-items:stretch}
      [data-format='case'] .scene[data-layout="casefile"] .scrim{background:
        linear-gradient(180deg, rgba(6,24,64,.42) 0%, rgba(6,24,64,.30) 30%, rgba(6,24,64,.62) 55%, rgba(6,24,64,.94) 72%, var(--navy-deep) 100%)}
      /* imageless case scenes fill the frame instead of hugging the caption band */
      [data-format='case'] .scene[data-layout="comic"] .scene-content,
      [data-format='case'] .scene[data-layout="board"] .scene-content,
      [data-format='case'] .scene[data-layout="step"] .scene-content,
      [data-format='case'] .scene[data-layout="stat"] .scene-content{top:150px;bottom:430px;justify-content:center}
      /* hero/verdict reuse the cover image as a dim backdrop */
      [data-format='case'] .scene[data-layout="hero"] .scene-bg,
      [data-format='case'] .scene[data-layout="verdict"] .scene-bg{opacity:.45;filter:saturate(.7)}
      /* symmetric bumper — same reason as the cta rule above */
      [data-format='case'] .scene[data-layout="verdict"] .scene-content{top:60px;bottom:60px;justify-content:center}

      /* ── tutorial format: simulated product UI ── */
      /* Full-bleed step: this is watched on a phone mid-scroll, so the simulated
         screen takes the full frame width (44px inset vs the shared 56px) and the
         type is sized to be read at a glance. flex-start, not center — a 2-row
         panel centred in the box left a dead band above the title, which is where
         the eye lands first. bottom:420 keeps the note off the caption band now
         that the panel grows into the free height. */
      [data-format='tutorial'] .scene[data-layout="uistep"] .scene-content{top:190px;bottom:420px;
        left:44px;right:44px;justify-content:flex-start;align-items:stretch;gap:28px}
      [data-format='tutorial'] .scene[data-layout="hook"] .scene-content{bottom:520px}
      [data-format='tutorial'] .scene[data-layout="hero"] .scene-content,
      [data-format='tutorial'] .scene[data-layout="tip"] .scene-content,
      [data-format='tutorial'] .scene[data-layout="step"] .scene-content{top:150px;bottom:430px;justify-content:center}
      [data-format='tutorial'] .scene[data-layout="hero"] .scene-bg,
      [data-format='tutorial'] .scene[data-layout="tip"] .scene-bg,
      [data-format='tutorial'] .scene[data-layout="cta"] .scene-bg{opacity:.35;filter:saturate(.6)}
      /* ── chat format (data-format='chat') ──
         Thai-safe: letter-spacing >= 0, line-height >= 1.3, break-word เท่านั้น */
      [data-format='chat'] .scene[data-layout="chat_in"] .scene-content,
      [data-format='chat'] .scene[data-layout="chat_out"] .scene-content{
        top:150px;bottom:400px;justify-content:flex-start}
      [data-format='chat'] .scene[data-layout="chat_in"] .scene-bg,
      [data-format='chat'] .scene[data-layout="chat_out"] .scene-bg,
      [data-format='chat'] .scene[data-layout="recap"] .scene-bg{opacity:.28;filter:saturate(.6)}
      [data-format='chat'] .scene[data-layout="recap"] .scene-content{
        top:150px;bottom:430px;justify-content:center}
      .ch-head{display:flex;align-items:center;gap:20px;padding-bottom:26px;
        border-bottom:2px solid rgba(255,255,255,.12);margin-bottom:26px}
      .ch-ava{flex:0 0 auto;width:74px;height:74px;border-radius:50%;
        background:linear-gradient(135deg,var(--amber),var(--amber-soft));
        display:flex;align-items:center;justify-content:center;
        font-weight:800;font-size:38px;color:#11182b}
      .ch-name{font-weight:800;font-size:40px;line-height:1.32;color:#fff}
      .ch-stamp{font-weight:600;font-size:28px;line-height:1.34;color:var(--muted)}
      .ch-thread{display:flex;flex-direction:column;gap:22px}
      .ch-bub{max-width:82%;padding:26px 30px;border-radius:34px;
        font-weight:700;font-size:38px;line-height:1.38;overflow-wrap:break-word}
      .ch-bub.them{align-self:flex-start;background:rgba(28,43,79,.94);
        border:1px solid rgba(255,255,255,.10);border-bottom-left-radius:10px;color:#dbe5fb}
      .ch-bub.them.alert{background:rgba(255,107,98,.16);
        border-color:rgba(255,107,98,.55);color:#ffd9d6}
      .ch-bub.me{align-self:flex-end;color:#11182b;border-bottom-right-radius:10px;
        background:linear-gradient(135deg,var(--amber),var(--amber-soft))}
      .ch-verdict{margin-top:28px;background:rgba(74,222,128,.14);
        border:2px solid rgba(74,222,128,.55);border-radius:26px;padding:26px 30px;
        font-weight:800;font-size:38px;line-height:1.38;color:#c9f7d8;overflow-wrap:break-word}
      /* ── myth format (data-format='myth') ──
         การ์ดกระดาษบนโต๊ะตรวจ: พื้นสว่าง ตัวหนังสือเข้ม ตรงข้ามกับซีนอื่นที่เป็น
         ตัวขาวบนน้ำเงิน — คนดูต้องรู้ทันทีว่า "นี่คือของที่กำลังถูกตรวจ"
         Thai-safe: letter-spacing >= 0, line-height >= 1.3, break-word เท่านั้น */
      [data-format='myth'] .scene[data-layout="belief"] .scene-content,
      [data-format='myth'] .scene[data-layout="proof"] .scene-content,
      [data-format='myth'] .scene[data-layout="verdict"] .scene-content{top:170px;bottom:410px;justify-content:center}
      [data-format='myth'] .scene[data-layout="belief"] .scene-bg,
      [data-format='myth'] .scene[data-layout="proof"] .scene-bg,
      [data-format='myth'] .scene[data-layout="verdict"] .scene-bg,
      [data-format='myth'] .scene[data-layout="tip"] .scene-bg,
      [data-format='myth'] .scene[data-layout="cta"] .scene-bg{opacity:.26;filter:saturate(.62)}
      [data-format='myth'] .mb-card{position:relative;background:#FBF7EC;color:#141d33;
        border-radius:26px;padding:40px 38px;transform:rotate(-1.1deg);
        box-shadow:0 30px 72px rgba(0,0,0,.52)}
      [data-format='myth'] .mb-kicker{font-weight:800;font-size:30px;line-height:1.34;
        color:#8a6d28;margin-bottom:16px;overflow-wrap:break-word}
      [data-format='myth'] .mb-belief{font-weight:800;font-size:60px;line-height:1.3;
        overflow-wrap:break-word}
      [data-format='myth'] .mb-why{margin-top:22px;font-weight:600;font-size:36px;
        line-height:1.4;color:#41506b;overflow-wrap:break-word}
      [data-format='myth'] .mb-stamp{display:inline-block;margin-top:30px;padding:16px 28px;
        border:6px solid #c0392b;border-radius:14px;transform:rotate(-4deg);
        font-weight:800;font-size:44px;line-height:1.3;color:#c0392b;
        text-transform:none;opacity:.94;overflow-wrap:break-word}
      [data-format='myth'] .mb-meter{display:flex;gap:12px;margin-top:30px}
      [data-format='myth'] .mb-meter .lv{flex:1;height:20px;border-radius:10px;
        background:rgba(20,29,51,.16)}
      [data-format='myth'] .mb-meter .lv.on{background:#c0392b}
      [data-format='myth'] .mb-meter.half .lv.on{background:var(--amber-bright)}
      /* สีตัวหนังสือบนการ์ดต้องเป็นสีเข้ม: --muted (#BCD2FF) ทำมาสำหรับพื้นน้ำเงิน
         บนการ์ดสีครีมมันเหลือคอนทราสต์ ~1.3:1 = ป้ายที่เป็นตัวถอดรหัสของมิเตอร์
         หายไปจากจอ เหลือแค่ขีดสีลอยๆ ที่คนดูแปลไม่ได้ */
      [data-format='myth'] .mb-meter-l{display:flex;gap:12px;margin-top:14px;
        font-weight:700;font-size:26px;line-height:1.34;color:#5b6b8a}
      [data-format='myth'] .mb-meter-l span{flex:1;text-align:center}
      [data-format='myth'] .mb-fact{font-weight:800;font-size:52px;line-height:1.3;
        color:#141d33;overflow-wrap:break-word}
      [data-format='myth'] .mb-src{margin-top:26px;padding-top:20px;
        border-top:2px solid rgba(20,29,51,.18);font-weight:700;font-size:28px;
        line-height:1.34;color:#5b6b8a}
      /* ── war-room format (data-format='warroom') ──
         uistep ใช้ markup เดิมทุกอย่าง เปลี่ยนแค่กรอบที่ห่อมัน เพื่อให้ตะแกรง
         ui_vocab + ตัวนับขั้นตอนทำงานเหมือนเดิมโดยไม่ต้องแก้โค้ดตะแกรง */
      [data-format='warroom'] .scene-bg::after{content:"";position:absolute;inset:0;
        background-image:linear-gradient(rgba(46,139,255,.09) 1px,transparent 1px),
          linear-gradient(90deg,rgba(46,139,255,.09) 1px,transparent 1px);background-size:96px 96px}
      /* dashboard ไม่มี override โดยตั้งใจ — ใช้ .scene-content ฐานที่เกาะแถบคำบรรยาย
         ของเดิมใส่ top:170px+justify-content:center ไว้ ซึ่งดันการ์ดขึ้นไปนั่งทับโซนรูป
         (ตรงนั้น scrim ยังใส) แล้วทิ้งพื้นน้ำเงินสะอาดครึ่งล่างว่างเปล่า ~400px */
      [data-format='warroom'] .scene[data-layout="alarm"] .scene-content,
      [data-format='warroom'] .scene[data-layout="uistep"] .scene-content{
        top:160px;bottom:410px;justify-content:center}
      [data-format='warroom'] .scene[data-layout="alarm"] .scene-bg,
      [data-format='warroom'] .scene[data-layout="cta"] .scene-bg{opacity:.30;filter:saturate(.6)}
      /* แผงยังเป็นหน้าจอ Ads Manager สว่างเหมือนเดิม — มันคือสิ่งที่คนดูต้องทำตาม
         ทาพื้นให้ดำเมื่อไรคือทำลายความเป็นหน้าจอจริง และ breadcrumb ที่พื้นโปร่งใส
         จะเหลือ contrast 3.85 ทันที · ห้องควบคุมจึงแต่งที่ "กรอบ" ให้เป็นจอมอนิเตอร์แทน */
      [data-format='warroom'] .ui-panel{border:6px solid #0a1a3d;
        box-shadow:0 0 0 3px rgba(88,146,255,.5),0 0 70px rgba(46,139,255,.28),0 30px 76px rgba(0,0,0,.62)}
      .wr-live{display:flex;align-items:center;gap:14px;font-weight:800;font-size:28px;
        letter-spacing:.10em;color:var(--muted);margin-bottom:20px}
      .wr-live i{width:18px;height:18px;border-radius:50%;background:var(--red);
        box-shadow:0 0 18px rgba(255,107,98,.85)}
      .wr-gauge{background:rgba(9,22,52,.88);border:2px solid rgba(88,146,255,.34);
        border-radius:26px;padding:28px 30px}
      .wr-gauge-l{font-weight:700;font-size:30px;line-height:1.34;color:var(--muted)}
      .wr-spark{height:210px;margin-top:18px;display:block;width:100%}
      .wr-spark .grid{stroke:rgba(88,146,255,.20);stroke-width:2;stroke-dasharray:10 14}
      .wr-spark .line{fill:none;stroke-width:6;stroke-linecap:round;stroke-linejoin:round}
      .wr-spark .head{stroke:rgba(9,22,52,.9);stroke-width:4}
      .wr-kpis{display:flex;gap:18px;margin-top:22px}
      /* แถบสีหัวการ์ด: การ์ดที่มีเลขสั้น ("0") เคยเหลือที่ว่างจนดูเหมือนช่องเปล่า
         แถบนี้ทำให้ทั้งสองใบอ่านเป็นชุดเดียวกันไม่ว่าเลขจะยาวสั้นแค่ไหน */
      .wr-kpi{position:relative;overflow:hidden;flex:1;background:rgba(9,22,52,.88);
        border:2px solid rgba(88,146,255,.28);border-radius:22px;padding:30px 20px 24px}
      .wr-kpi::before{content:"";position:absolute;top:0;left:0;right:0;height:7px;
        background:var(--amber-bright);opacity:.85}
      .wr-kpi.bad::before{background:var(--red)}
      .wr-kpi .n{font-weight:800;font-size:64px;line-height:1.3;color:var(--amber-bright)}
      .wr-kpi.bad .n{font-size:76px;color:var(--red)}
      .wr-kpi .t{font-weight:700;font-size:26px;line-height:1.34;color:var(--muted);
        margin-top:6px;letter-spacing:.05em}
      .wr-alarm{margin-top:24px;background:rgba(255,107,98,.16);border-left:10px solid var(--red);
        border-radius:0 22px 22px 0;padding:26px 30px;font-weight:800;font-size:38px;
        line-height:1.38;color:#ffd9d6;overflow-wrap:break-word}
      .ui-rail{display:flex;align-items:center;gap:18px}
      .ui-rail .rl{font-weight:700;font-size:36px;letter-spacing:.04em;color:var(--amber-bright)}
      .ui-rail .dots{display:flex;gap:14px}
      .ui-rail .dot{width:24px;height:24px;border-radius:50%;background:rgba(188,210,255,.25);display:block}
      .ui-rail .dot.on{background:var(--amber-bright);box-shadow:0 0 16px rgba(255,180,84,.6)}
      .ui-step-title{font-weight:800;font-size:74px;line-height:1.18;color:#fff;overflow-wrap:break-word}
      /* The panel is the anchor for the tap ring + pointer tag (both absolute) and
         it fills the frame's free height: a real product screen does not shrink to
         fit two menu rows, and a short panel left a dead band under the step. */
      .ui-panel{position:relative;flex:1 1 auto;display:flex;flex-direction:column;
        background:#F2F4F8;border-radius:28px;
        box-shadow:0 30px 76px rgba(0,0,0,.52);border:2px solid rgba(255,255,255,.14)}
      .ui-chrome{display:flex;align-items:center;gap:18px;padding:24px 30px;
        background:#E2E6ED;border-bottom:3px solid #CDD3DD;border-radius:26px 26px 0 0}
      .ui-chrome .dotset{display:flex;gap:12px}
      .ui-chrome .dotset i{width:20px;height:20px;border-radius:50%;background:#B9C0CC;display:block}
      .ui-chrome .title{font-weight:700;font-size:38px;color:#3A4351}
      .ui-crumb{padding:22px 30px;font-weight:600;font-size:33px;color:#66707F;border-bottom:2px solid #DDE2EA}
      .ui-list{flex:1 1 auto;padding:26px 24px;display:flex;flex-direction:column;justify-content:center;gap:16px}
      /* rows that are not the step's target recede: the viewer's eye should land
         on one row only, the same way a spotlight works on stage */
      .ui-item{display:flex;align-items:center;gap:20px;padding:34px 30px;border-radius:18px;
        font-weight:600;font-size:52px;color:#2C3341;background:#fff;border:2px solid #E3E7EE;
        opacity:.42;filter:blur(1.2px)}
      .ui-item .lb{overflow-wrap:break-word}
      .ui-item .mk{margin-left:auto;flex:0 0 auto}
      .ui-item.done{color:#6C7688;background:#EDF1F6}
      .ui-item.done .mk{width:28px;height:28px;border-radius:50%;background:#2FA36B}
      .ui-item.target{background:#FFF3E0;border:5px solid var(--amber);color:#141B28;font-weight:800;
        opacity:1;filter:none;box-shadow:0 0 0 12px rgba(255,180,84,.16),0 20px 46px rgba(0,0,0,.32)}
      .ui-item.target .mk{width:0;height:0;border-top:20px solid transparent;
        border-bottom:20px solid transparent;border-right:28px solid var(--amber)}
      .ui-field{margin:0 24px 24px;padding:26px 30px;border:5px solid var(--amber);
        border-radius:18px;background:#FFF8EE}
      .ui-field .fl{font-weight:600;font-size:32px;color:#66707F}
      .ui-field .fv{font-weight:800;font-size:62px;color:#141B28;overflow-wrap:break-word}
      /* "กดตรงนี้" pointer: a fixed two-word tag, not the model's sentence — it
         floats ABOVE the target row so it never covers the menu name the viewer
         has to read and copy. The model's full instruction stays in .ui-note. */
      .ui-point{position:absolute;right:26px;transform:translateY(-100%);z-index:7;
        background:var(--amber-bright);color:#0B1C3F;font-weight:800;font-size:36px;line-height:1;
        padding:14px 22px;border-radius:14px;box-shadow:0 14px 32px rgba(0,0,0,.4)}
      .ui-point:after{content:"";position:absolute;right:34px;bottom:-16px;width:0;height:0;
        border-left:14px solid transparent;border-right:14px solid transparent;
        border-top:18px solid var(--amber-bright)}
      /* the step instruction, full sentence, directly under the panel */
      .ui-note{font-weight:700;font-size:44px;line-height:1.28;color:var(--ink);overflow-wrap:break-word}
      /* tap ring: borrowed from the phone-capture direction — it answers "where do
         I press" without a word of copy */
      .ui-tap{position:absolute;z-index:5;pointer-events:none}
      .ui-tap .rg{position:absolute;left:-70px;top:-70px;width:140px;height:140px;border-radius:50%;
        border:7px solid rgba(255,180,84,.9);box-shadow:0 0 40px rgba(255,180,84,.55)}
      .ui-tap .dt{position:absolute;left:-30px;top:-30px;width:60px;height:60px;border-radius:50%;
        background:rgba(255,255,255,.92);box-shadow:0 0 22px rgba(255,255,255,.6)}

      /* ── progress / badges / caption ── */
      .progress-track{position:absolute;top:0;left:0;width:{{.Width}}px;height:10px;background:rgba(255,255,255,.08);z-index:30}
      .progress-fill{position:absolute;top:0;left:0;width:0;height:10px;
        background:linear-gradient(90deg,var(--amber-bright),var(--amber-soft));box-shadow:0 0 22px rgba(255,180,84,.6)}
      .badge-row{position:absolute;top:74px;left:56px;display:flex;align-items:center;gap:18px;z-index:25;opacity:0}
      .badge-brand{font-weight:800;font-size:34px;letter-spacing:.12em;color:#fff;background:var(--amber);
        padding:14px 28px;border-radius:14px;box-shadow:0 12px 30px rgba(255,180,84,.35)}
      .badge-cat{font-weight:700;font-size:26px;letter-spacing:.18em;color:var(--amber-bright);
        border:2px solid rgba(255,180,84,.5);padding:12px 22px;border-radius:14px;background:rgba(255,180,84,.08)}

      .cap-stage{position:absolute;left:0;right:0;bottom:210px;display:flex;justify-content:center;
        pointer-events:none;z-index:28}
      .cap-phrase{position:absolute;bottom:0;width:920px;text-align:center;
        font-weight:700;font-size:48px;line-height:1.34;color:#fff;
        background:rgba(8,24,64,.86);border:2px solid var(--amber-bright);border-radius:24px;
        padding:26px 40px;opacity:0;box-shadow:0 18px 50px rgba(0,0,0,.5)}
      /* Thai line breaking: no `anywhere` / `word-break:break-word` — Chromium's
         ICU dictionary breaks Thai at word boundaries by default; break-word is
         kept only as the last-resort escape for a truly unbreakable run. */
      .cap-word{display:inline;white-space:normal;overflow-wrap:break-word}
      h1.title,.stat-label,.row .rt,.step-title,.step-of,.kicker,.sub,.brandbig,
      .chip .t{overflow-wrap:break-word}
      .cta,.pill{max-width:100%;overflow-wrap:break-word}
      /* key word is inline-block so GSAP can scale it (transform is a no-op on inline) */
      .cap-word.key{color:var(--amber-bright);font-weight:800;display:inline-block;will-change:transform}
    </style>
  </head>
  <body>
    <div id="root" data-theme="{{.ThemeKey}}" data-format="{{.Format}}" data-composition-id="main" data-start="0" data-duration="{{.DurationSeconds}}" data-width="{{.Width}}" data-height="{{.Height}}">

      <div id="progress" class="clip progress-track" data-start="0" data-duration="{{.DurationSeconds}}" data-track-index="7">
        <div class="progress-fill" id="progressFill"></div></div>
      <div id="badges" class="clip badge-row" data-start="{{if .Cover}}0{{else}}0.3{{end}}" data-duration="{{.DurationSeconds}}" data-track-index="2">
        <div class="badge-brand">{{.BrandName}}</div>{{if .CategoryLabel}}<div class="badge-cat">{{.CategoryLabel}}</div>{{end}}</div>
      <div id="capStage" class="clip cap-stage" data-start="0" data-duration="{{.DurationSeconds}}" data-track-index="9" data-layout-allow-overflow></div>

      <audio id="vo" data-start="0" data-duration="{{.DurationSeconds}}" data-track-index="5" src="{{.VoiceSrc}}" data-volume="1"></audio>
      {{if .AmbientSrc}}<audio id="amb" data-start="0" data-duration="{{.DurationSeconds}}" data-track-index="3" src="{{.AmbientSrc}}" data-volume="0.15"></audio>{{end}}
      {{range $i, $cue := .TransitionCues}}<audio id="sfx{{$i}}" data-start="{{$cue.AtSec}}" data-duration="1.0" data-track-index="{{addInt 30 $i}}" src="{{$cue.Src}}" data-volume="0.5"></audio>
      {{end}}
    </div>

    <script>
      const tl = gsap.timeline({ paused: true });
      const TOTAL = {{.DurationSeconds}};
      const MOTION_UP = {{if .AudioMotion}}true{{else}}false{{end}};
      const MOTION_V2 = {{if .MotionV2}}true{{else}}false{{end}};
{{- if .Cover}}
      const COVER = true;
{{- end}}
      const ENTRANCE_DUR = {{.EntranceDur}} || 0.6;
      const ENTRANCE_EASE = "{{.EntranceEase}}" || "power3.out";
      const BG_ZOOM_TO = {{.BGZoomTo}} || 1.06;
      const FORMAT_CASE = {{if eq .Format "case"}}true{{else}}false{{end}};
      const FORMAT_TUTORIAL = {{if eq .Format "tutorial"}}true{{else}}false{{end}};
      const FORMAT_CHAT = {{if eq .Format "chat"}}true{{else}}false{{end}};
      const FORMAT_WARROOM = {{if eq .Format "warroom"}}true{{else}}false{{end}};
      const FORMAT_MYTH = {{if eq .Format "myth"}}true{{else}}false{{end}};
      const CASE_NO = {{.CaseNumber}} || 0;

      // ── Scene content (cleaned: NO emoji, real slots) ──
      const SCENES = {{.ScenesJSON}};

      // Build the per-scene wrappers in-page from SCENES (start/end/bg), inserted
      // ahead of the #progress overlay so track order matches the static layout.
      const root = document.getElementById("root");
      SCENES.forEach((sc, i) => {
        const w = document.createElement("div");
        w.id = "scene-" + sc.scene; w.className = "scene clip";
        w.setAttribute("data-start", sc.start);
        w.setAttribute("data-duration", Math.max(0.1, sc.end - sc.start).toFixed(3));
        w.setAttribute("data-track-index", 10 + i);
        w.setAttribute("data-layout", sc.type || "");
        w.setAttribute("data-layout-allow-overflow", "");
        const evPhoto = sc.type === "evidence";
        // hero/verdict (case) and hero/tip/cta (tutorial) without their own image
        // reuse the cover shot (scene 0's bg) as a dim backdrop — bookends the
        // clip at zero extra image cost.
        const reuseCover =
          (FORMAT_CASE && (sc.type === "hero" || sc.type === "verdict")) ||
          (FORMAT_TUTORIAL && (sc.type === "hero" || sc.type === "tip" || sc.type === "cta")) ||
          (FORMAT_CHAT && (sc.type === "chat_in" || sc.type === "chat_out" || sc.type === "recap" || sc.type === "cta")) ||
          (FORMAT_WARROOM && (sc.type === "dashboard" || sc.type === "alarm" || sc.type === "cta")) ||
          (FORMAT_MYTH && (sc.type === "belief" || sc.type === "proof" || sc.type === "verdict" || sc.type === "tip" || sc.type === "cta"));
        const bgSrc = (!sc.bg && reuseCover && SCENES[0] && SCENES[0].bg) ? SCENES[0].bg : sc.bg;
        // giant faint case-number watermark fills imageless case scenes
        const wm = (FORMAT_CASE && CASE_NO > 0 &&
          (sc.type === "comic" || sc.type === "board" || sc.type === "step" || sc.type === "stat"))
          ? '<div class="cf-wm">' + "คดี " + CASE_NO + '</div>' : '';
        w.innerHTML =
          '<div class="scene-bg-wrap"><div class="scene-bg" data-layout-allow-overflow' +
          (bgSrc && !evPhoto ? ' style="background-image:url(\'' + bgSrc + '\')"' : '') +
          '></div></div>' +
          '<div class="scrim"></div>' + wm + '<div class="scene-content" data-i="' + i + '"></div>';
        root.insertBefore(w, document.getElementById("progress"));
      });

      const SEGMENTS = {{.SegmentsJSON}};

      function el(tag,cls,html){const e=document.createElement(tag);if(cls)e.className=cls;if(html!=null)e.innerHTML=html;return e;}
      function rowsBlock(rows){const w=el("div","rows");(rows||[]).forEach(r=>{const row=el("div","row"+(r.bad?" bad":""));row.appendChild(el("div","dot"));row.appendChild(el("div","rt",r.t));w.appendChild(row);});return w;}
      function chipsBlock(chips){const w=el("div","chips");chips.forEach(c=>{const ch=el("div","chip");ch.appendChild(el("div","n",c.n));ch.appendChild(el("div","t",(c.t||"").replace(/\n/g,"<br>")));w.appendChild(ch);});return w;}

      // ── war-room spark ──
      // เส้นกราฟจริง ไม่ใช่ clip-path เงาภูเขา: ของเดิมวาดยอดเขาชุดเดียวกันทุกคลิป
      // ที่เคยผลิตมา คนดูซ้ำจึงจำได้ว่าเป็นภาพประกอบ ไม่ใช่ข้อมูล · ชุดตัวเลขสุ่มจาก
      // ข้อความของซีนเอง (seeded) คลิปเดิมเรนเดอร์ซ้ำได้เส้นเดิม คนละคลิปได้คนละเส้น
      let sparkN=0;
      function sparkChart(seed){
        const uid=sparkN++;
        // PADR กว้างกว่า PAD เพราะจุดล่าสุดมีวงเรืองแสง r=22 อยู่ตรงนั้น ถ้าเว้นเท่ากัน
        // สองข้างวงจะโดนขอบ svg ตัดครึ่ง
        const NS="http://www.w3.org/2000/svg",W=1000,H=210,PAD=16,PADR=46,N=9;
        let h=2166136261;
        for(let i=0;i<seed.length;i++){h^=seed.charCodeAt(i);h=Math.imul(h,16777619);}
        const rnd=()=>{h^=h<<13;h^=h>>>17;h^=h<<5;return ((h>>>0)%1000)/1000;};
        const pts=[];
        for(let i=0;i<N;i++){
          const t=i/(N-1);
          // ไต่ขึ้นเป็นหลัก + สั่นเล็กน้อย — ห้องควบคุมเปิดมาดูตัวเลขที่กำลังพุ่ง
          const v=Math.min(.97,.08+t*.70+rnd()*.24);
          pts.push([PAD+t*(W-PAD-PADR),H-PAD-v*(H-PAD*2)]);
        }
        const svg=document.createElementNS(NS,"svg");
        svg.setAttribute("class","wr-spark");
        svg.setAttribute("viewBox","0 0 "+W+" "+H);
        svg.setAttribute("preserveAspectRatio","none");
        const mk=(t,a)=>{const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);return e;};
        const defs=document.createElementNS(NS,"defs");
        const lg=mk("linearGradient",{id:"wrl"+uid,x1:"0",y1:"0",x2:"1",y2:"0"});
        lg.appendChild(mk("stop",{offset:"0","stop-color":"#FFB454"}));
        lg.appendChild(mk("stop",{offset:"1","stop-color":"#FF6B62"}));
        const ag=mk("linearGradient",{id:"wra"+uid,x1:"0",y1:"0",x2:"0",y2:"1"});
        ag.appendChild(mk("stop",{offset:"0","stop-color":"#FF8A5B","stop-opacity":".38"}));
        ag.appendChild(mk("stop",{offset:"1","stop-color":"#FF8A5B","stop-opacity":"0"}));
        defs.appendChild(lg);defs.appendChild(ag);svg.appendChild(defs);
        const base=H-PAD;
        [.25,.5,.75].forEach(g=>{const y=(H*g).toFixed(1);
          svg.appendChild(mk("line",{class:"grid",x1:PAD,x2:W-PAD,y1:y,y2:y}));});
        const d=pts.map((p,i)=>(i?"L":"M")+p[0].toFixed(1)+" "+p[1].toFixed(1)).join(" ");
        const ex=pts[N-1][0].toFixed(1),ey=pts[N-1][1].toFixed(1);
        svg.appendChild(mk("path",{d:d+" L"+ex+" "+base+" L"+PAD+" "+base+" Z",
          fill:"url(#wra"+uid+")"}));
        svg.appendChild(mk("path",{class:"line",d:d,stroke:"url(#wrl"+uid+")"}));
        // เส้นชี้ค่าล่าสุด: ขอบขวาของ area ตัดตรงอยู่แล้ว ถ้าไม่ลากเส้นทับมันจะอ่าน
        // เป็นรอยต่อ gradient ที่ดูเหมือน artifact แทนที่จะเป็นหมุดบอกค่าปัจจุบัน
        svg.appendChild(mk("line",{x1:ex,x2:ex,y1:ey,y2:base,
          stroke:"#FF6B62","stroke-opacity":".38","stroke-width":"3"}));
        svg.appendChild(mk("circle",{cx:ex,cy:ey,r:22,fill:"#FF6B62","fill-opacity":".22"}));
        svg.appendChild(mk("circle",{class:"head",cx:ex,cy:ey,r:11,fill:"#FF6B62"}));
        return svg;
      }

      // uistep scenes register their target row here; the markers (pointer tag +
      // tap ring) are positioned after layout, when offsets are real.
      const uiStepMarkers=[];
      SCENES.forEach((sc,i)=>{
        const c=document.querySelector('.scene-content[data-i="'+i+'"]');
        if(!c)return;
        if(sc.kicker) c.appendChild(el("div","kicker",sc.kicker));
        if(sc.type==="hook"){ c.appendChild(rowsBlock(sc.rows)); }
        else if(sc.type==="hero"){ c.appendChild(el("h1","title",sc.title)); if(sc.sub)c.appendChild(el("div","sub",sc.sub)); }
        else if(sc.type==="stat"){
          const card=el("div","card");
          const meta=MOTION_V2?parseStatNumber(sc.stat):null;
          const numHTML=meta?'<span class="stat-num" data-final="'+sc.stat+'">0</span>':(sc.stat||"");
          card.appendChild(el("div","stat",numHTML+(sc.unit?'<span class="unit">'+sc.unit+'</span>':'')));
          card.appendChild(el("div","stat-label",sc.statLabel));
          c.appendChild(card);
          if(sc.chips) c.appendChild(chipsBlock(sc.chips));
        }
        else if(sc.type==="step"){
          const head=el("div","step-head");
          head.appendChild(el("div","step-num",sc.num));
